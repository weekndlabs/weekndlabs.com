{
  "name": "weekndlabs-com",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Every request goes through worker.js so www can redirect by host.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "weekndlabs.com/*", "zone_name": "weekndlabs.com" },
    { "pattern": "www.weekndlabs.com/*", "zone_name": "weekndlabs.com" }
  ]
}
